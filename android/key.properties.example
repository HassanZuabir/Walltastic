# Copy this file to android/key.properties and fill in your keystore details.
# Generate a keystore with:
#   keytool -genkey -v -keystore ~/walltastic-upload.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
# NEVER commit key.properties or the .jks file to source control.
storePassword=YOUR_STORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=upload
storeFile=/absolute/path/to/walltastic-upload.jks
